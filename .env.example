# Copy to `.env` and adjust. There are NO secrets here: Novelmaker stores
# provider API keys in its own database under NOVELMAKER_APPDATA, not in env.

# Host port for the web UI/API (published on all host interfaces).
NOVELMAKER_HTTP_PORT=3002

# Build context. Defaults to the repo root when compose is run from here. On a
# deployment host that keeps compose files apart from source, set this to a
# checkout of the repo (e.g. /mnt/user/appdata/novelmaker-src).
# NOVELMAKER_BUILD_CONTEXT=.

# Host path bound to the container's /data. Holds the library database, config
# and the app's backups — and the provider keys, in plaintext.
# For a local trial use ./data; on Unraid use /mnt/user/appdata/novelmaker.
NOVELMAKER_APPDATA=./data

# Container timezone.
TZ=America/Los_Angeles
